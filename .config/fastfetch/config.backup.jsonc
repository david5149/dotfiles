{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": {
      "1": "#97ccf9",
      "2": "#d0bfe7",
      "3": "#b8c8d9"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "separator": "#e0e3e8"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{1}",
      "color": {
        "user": "#97ccf9"
      }
    },
    "break",
    {
      "type": "os",
      "key": "󱄅 os ",
      "keyColor": "#97ccf9"
    },
    {
      "type": "cpu",
      "key": " cpu",
      "keyColor": "#d0bfe7"
    },
    {
      "type": "memory",
      "key": "󰘚 ram",
      "keyColor": "#b8c8d9"
    },
    {
      "type": "shell",
      "key": " sh ",
      "keyColor": "#2a638a"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
